{
    "preset": "laravel",
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor"
    ],
    "rules": {
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "array_syntax": {
            "syntax": "short"
        },
        "not_operator_with_successor_space": true,
        "trailing_comma_in_multiline": true,
        "phpdoc_align": {
            "align": "left"
        },
        "single_quote": true,
        "method_argument_space": {
            "on_multiline": "ignore"
        }
    }
}